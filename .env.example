# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure through the deployment secret manager. Never commit the real value.
GEMINI_API_KEY=""

# APP_URL: Canonical application URL.
APP_URL=""

# DATABASE_URL: Server-only Neon PostgreSQL connection string with TLS enabled.
# Never expose via NEXT_PUBLIC_ or browser bundles.
DATABASE_URL=""

# PORTAL_SIGNING_SECRET: Independent server-only HMAC-SHA256 session signing secret.
# Use a high-entropy random value. Never reuse DATABASE_URL or any password.
PORTAL_SIGNING_SECRET=""

# PORTAL_OWNER_EMAIL: The single authorized BLACKTOWER OS operator identity for V1.
PORTAL_OWNER_EMAIL=""

# PORTAL_OWNER_PASSWORD_HASH: Server-only scrypt password envelope generated by
# createScryptPasswordHash(). Never place the plaintext owner password here.
# Format: scrypt$N$r$p$base64urlSalt$base64urlDigest
PORTAL_OWNER_PASSWORD_HASH=""

# Recovery is intentionally disabled in V1 until a verified email/recovery
# provider is configured. Do not add a fake recovery secret.
