# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Required canonical production database connection string for Neon PostgreSQL.
# Must be a server-only postgresql:// URI with TLS enabled (e.g., postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require).
# Never expose to client code via NEXT_PUBLIC_.
DATABASE_URL=""

# PORTAL_SIGNING_SECRET: Required independent server-only secret (minimum 16 characters)
# used exclusively for signing and verifying BLACKTOWER OS™ HMAC-SHA256 operator session tokens.
# Must never be reused from DATABASE_URL or Vault passwords.
PORTAL_SIGNING_SECRET=""
